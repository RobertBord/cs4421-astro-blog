---
import { getCollection, getEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { relatedPosts } from '../../utils/posts';

const { slug } = Astro.params;
const post = slug ? await getEntry('blog', slug) : undefined;

if (!post || post.data.draft) {
	return new Response('Article not found', { status: 404 });
}

const { Content } = await render(post);
const author = post.data.author ? await getEntry(post.data.author) : undefined;
const related = relatedPosts(await getCollection('blog'), post);
---

<BlogPost {...post.data} author={author} related={related}>
	<Content />
</BlogPost>
