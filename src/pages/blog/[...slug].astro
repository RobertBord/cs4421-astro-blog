---
import { type CollectionEntry, getCollection, getEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { publishedPosts, relatedPosts } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = publishedPosts(await getCollection('blog'));
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
const author = post.data.author ? await getEntry(post.data.author) : undefined;
const related = relatedPosts(await getCollection('blog'), post);
---

<BlogPost {...post.data} author={author} related={related}>
	<Content />
</BlogPost>
