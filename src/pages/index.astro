---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { CATEGORIES, categorySlug, publishedPosts, selectLead } from '../utils/posts';
const posts = publishedPosts(await getCollection('blog'));
const lead = selectLead(posts);
const latest = posts.filter(post => post.id !== lead?.id);
---
<!doctype html>
<html lang="en">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main id="main" class="site-width" tabindex="-1">
			<div class="masthead">
				<div><p class="eyebrow">Independent Formula 1 journalism</p><h1>F1 bits<span>.</span></h1></div>
				<p class="strapline">The stories beyond <br />the chequered flag.</p>
			</div>
			<nav class="topics" aria-label="Explore topics">{CATEGORIES.map(category => <a href={`/blog/category/${categorySlug(category)}/`}>{category}</a>)}</nav>
			{lead ? <div class="front-page">
				<section class="lead" aria-label="Lead story"><p class="section-label">In focus</p><PostCard post={lead} /></section>
				<aside aria-labelledby="latest-heading"><div class="latest-heading"><h2 id="latest-heading">Latest bits</h2><a href="/blog/">All articles</a></div>
					{latest.length ? latest.slice(0, 3).map(post => <PostCard post={post} />) : <p>More stories are on the way.</p>}
					<a class="feed-link" href="/rss.xml">Follow the feed</a>
				</aside>
			</div> : <section class="empty"><h2>The next story starts here.</h2><p>Our first dispatch is on its way.</p><a href="/about/">About F1 bits</a></section>}
			<section class="editorial-note"><p class="eyebrow">Our approach</p><h2>Curiosity, without the clickbait.</h2><p>Facts, reported rumours, and opinion deserve different labels. We follow the evidence and tell you where it ends.</p><a href="/about/#standards">Our editorial standards</a></section>
		</main>
		<Footer />
	</body>
</html>
<style>
	main { max-width: none; padding: 0; }
	.masthead { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: 2rem 0 1.5rem; }
	.masthead .eyebrow { margin-bottom: 0.25rem; }
	h1 { font-size: 5.5rem; margin: 0; line-height: 1.1; }
	h1 span { color: var(--accent); }
	.strapline { font-family: var(--font-display); font-size: 1.5rem; line-height: 1.4; margin: 0; border-left: 3px solid var(--teal); padding-left: 1.5rem; }
	.topics { display: flex; flex-wrap: wrap; gap: 1rem 2rem; padding-block: 0.85rem; border-top: 2px solid var(--ink); border-bottom: 1px solid var(--line); }
	.topics a { color: var(--ink); font-size: 0.8rem; text-transform: uppercase; font-weight: bold; text-decoration: none; }
	.topics a:hover { color: var(--accent); text-decoration: underline; }
	.front-page { display: grid; grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr); gap: 2.5rem; padding-top: 1.5rem; }
	.section-label { font-size: 0.75rem; text-transform: uppercase; font-weight: bold; color: var(--teal); margin: 0 0 1rem; }
	.lead :global(h2) { font-size: 2.5rem; }
	aside { border-left: 1px solid var(--line); padding-left: 2rem; }
	.latest-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
	.latest-heading h2 { font-size: 1.25rem; margin: 0; }
	.latest-heading a, .feed-link { font-size: 0.8rem; }
	aside :global(.story) { border-bottom: 1px solid var(--line); margin-bottom: 1rem; }
	aside :global(h2) { font-size: 1.6rem; }
	aside :global(.summary) { font-size: 0.9rem; }
	.editorial-note { border-top: 2px solid var(--ink); margin-top: 2rem; padding-block: 2rem; }
	.editorial-note h2 { font-size: 2rem; }
	.editorial-note p { max-width: 640px; }
	.editorial-note a { font-size: 0.9rem; }
	.empty { padding-block: 4rem; }
	@media (max-width: 680px) {
		.masthead { gap: 1rem; align-items: flex-start; flex-direction: column; padding-block: 1.5rem; }
		h1 { font-size: 3.75rem; }
		.strapline { font-size: 1.1rem; }
		.strapline br { display: none; }
		.front-page { grid-template-columns: 1fr; gap: 1rem; }
		.lead :global(h2) { font-size: 2rem; }
		aside { border-left: 0; border-top: 1px solid var(--line); padding: 1.5rem 0 0; }
	}
</style>