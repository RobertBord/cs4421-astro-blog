---
import HeaderLink from './HeaderLink.astro';
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
	<nav class="site-width" aria-label="Main navigation">
		<a class="brand" href="/" aria-label="F1 bits home"><img src="/brand/wordmark.svg" alt="F1 bits" width="207" height="48" /></a>
		<div class="links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog/">Articles</HeaderLink>
			<HeaderLink href="/about/">About</HeaderLink>
		</div>
	</nav>
</header>

<style>
	.site-header { background: white; border-top: 5px solid var(--accent); border-bottom: 1px solid var(--line); }
	nav { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 100px; }
	.brand { display: flex; flex-shrink: 0; }
	.brand img { width: 207px; height: 48px; }
	.links { display: flex; gap: 1.75rem; font-size: 0.9rem; }
	@media (max-width: 540px) {
		nav { flex-direction: column; justify-content: center; gap: 0.6rem; padding-block: 1rem; }
		.brand img { width: 173px; height: 40px; }
		.links { gap: 1.5rem; }
	}
</style>
