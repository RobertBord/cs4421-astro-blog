---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const destination = String(href).replace(/\/$/, '') || '/';
const isActive = pathname === destination || (destination !== '/' && pathname.startsWith(`${destination}/`));
---

<a href={href} class:list={[className, { active: isActive }]} aria-current={isActive ? 'page' : undefined} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
		color: var(--ink);
		padding-block: 0.4rem;
		border-bottom: 2px solid transparent;
	}
	a.active {
		font-weight: bolder;
		border-bottom-color: var(--accent);
	}
</style>
